<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 750" width="100%" height="100%">
  <defs>
    <linearGradient id="bgPhotoGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#eff6ff" />
      <stop offset="60%" stop-color="#dbeafe" />
      <stop offset="100%" stop-color="#bfdbfe" />
    </linearGradient>
    <linearGradient id="suitGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#1e3a5f" />
      <stop offset="100%" stop-color="#112239" />
    </linearGradient>
    <linearGradient id="hairGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#3d2314" />
      <stop offset="100%" stop-color="#231309" />
    </linearGradient>
    <linearGradient id="skinGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#ffd8be" />
      <stop offset="100%" stop-color="#f5c29f" />
    </linearGradient>
    <filter id="softShadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="12" stdDeviation="16" flood-color="#1e3a5f" flood-opacity="0.15" />
    </filter>
  </defs>

  <rect width="600" height="750" fill="url(#bgPhotoGrad)" />
  <circle cx="100" cy="150" r="140" fill="#ffffff" opacity="0.4" />
  <circle cx="520" cy="220" r="180" fill="#38bdf8" opacity="0.1" />
  
  <path d="M50,750 Q60,550 140,480 Q100,580 90,750 Z" fill="#0d9488" opacity="0.2" />
  <path d="M120,750 Q160,600 220,530 Q170,640 150,750 Z" fill="#0d9488" opacity="0.15" />

  <g id="figure" filter="url(#softShadow)">
    <path d="M200,240 C170,290 170,420 180,470 C220,490 380,490 420,470 C430,420 430,290 400,240 Z" fill="url(#hairGrad)" />

    <path d="M140,750 L140,540 C140,460 210,430 300,430 C390,430 460,460 460,540 L460,750 Z" fill="url(#suitGrad)" />
    
    <path d="M260,430 L300,560 L340,430 Z" fill="#ffffff" />
    <path d="M300,430 L300,560" stroke="#e2e8f0" stroke-width="2" />
    
    <path d="M235,430 L285,555 L245,610 L190,510 Z" fill="#254773" />
    <path d="M365,430 L315,555 L355,610 L410,510 Z" fill="#254773" />

    <rect x="270" y="360" width="60" height="85" rx="10" fill="url(#skinGrad)" />
    <path d="M270,395 C285,410 315,410 330,395" fill="none" stroke="#e0a985" stroke-width="2" />

    <ellipse cx="300" cy="275" rx="72" ry="92" fill="url(#skinGrad)" />

    <path d="M225,270 C225,180 270,165 300,165 C345,165 375,180 375,270 C360,210 330,195 300,195 C260,195 235,225 225,270 Z" fill="url(#hairGrad)" />
    <path d="M230,230 C220,310 215,390 235,450 C245,410 245,330 250,270 Z" fill="url(#hairGrad)" />
    <path d="M370,230 C380,310 385,390 365,450 C355,410 355,330 350,270 Z" fill="url(#hairGrad)" />

    <path d="M255,245 Q272,238 285,246" stroke="#231309" stroke-width="3" stroke-linecap="round" fill="none" />
    <path d="M315,246 Q328,238 345,245" stroke="#231309" stroke-width="3" stroke-linecap="round" fill="none" />
    
    <ellipse cx="270" cy="260" rx="7" ry="5" fill="#231309" />
    <circle cx="268" cy="258" r="2" fill="#ffffff" />
    <ellipse cx="330" cy="260" rx="7" ry="5" fill="#231309" />
    <circle cx="328" cy="258" r="2" fill="#ffffff" />
    
    <ellipse cx="250" cy="290" rx="14" ry="8" fill="#f43f5e" opacity="0.15" />
    <ellipse cx="350" cy="290" rx="14" ry="8" fill="#f43f5e" opacity="0.15" />

    <path d="M300,262 L297,285 L306,285" stroke="#d99975" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none" />

    <path d="M282,312 Q300,332 318,312" fill="none" stroke="#b91c1c" stroke-width="3" stroke-linecap="round" />
    <path d="M285,312 Q300,326 315,312" fill="#ffffff" />
  </g>

  <g transform="translate(60, 640)">
    <rect width="480" height="85" rx="16" fill="#ffffff" filter="url(#softShadow)" />
    <circle cx="50" cy="42" r="24" fill="#eff6ff" />
    <path d="M42,42 L48,48 L58,36" stroke="#0d9488" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" fill="none" />
    <text x="88" y="38" font-family="'Inter', sans-serif" font-size="16" font-weight="700" fill="#1e3a5f">Naidionara Maschio</text>
    <text x="88" y="58" font-family="'Inter', sans-serif" font-size="13" font-weight="500" fill="#64748b">Psicóloga Clínica &amp; Organizacional · CRP 08/42488</text>
  </g>
</svg>
